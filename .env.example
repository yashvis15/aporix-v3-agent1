# ---------------------------------------------------
# Aporix - Environment Variables
# ---------------------------------------------------

# Required: Google Gemini API key used to run the optimization LLM call.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the model used for optimization calls.
# Defaults to gemini-1.5-flash (free-tier compatible, supports JSON mode).
# Do NOT include "models/" prefix - just the model name.
# If unset or empty, the code will try fallback models automatically.
GEMINI_MODEL=gemini-1.5-flash

# Optional: override the Gemini API base URL.
# Defaults to https://generativelanguage.googleapis.com/v1beta
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Optional: max characters of extracted PDF text sent to the LLM in one call.
# Longer documents get truncated to control cost/latency in the MVP.
# (Future extension: chunk + multi-call for very large PDFs.)
MAX_INPUT_CHARS=60000

# ---------------------------------------------------
# Future extension hooks (not used yet, safe to ignore for MVP)
# ---------------------------------------------------

# x402 pay-per-use API integration
# X402_ENABLED=false
# X402_WALLET_ADDRESS=

# Database storage (e.g. Postgres via Prisma/Supabase)
# DATABASE_URL=

# User accounts / auth provider
# AUTH_SECRET=
# AUTH_PROVIDER_CLIENT_ID=
# AUTH_PROVIDER_CLIENT_SECRET=
